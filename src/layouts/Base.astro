---
import { ClientRouter } from 'astro:transitions';
import Field from '../components/Field.astro';
import Header from '../components/Header.astro';
import Readouts from '../components/Readouts.astro';
import Crosshair from '../components/Crosshair.astro';
import Channels from '../components/Channels.astro';

interface Props {
	title?: string;
	description?: string;
	/** Set false on pages that exist in one locale only — otherwise they'd
	 * advertise an hreflang alternate that 404s. */
	localized?: boolean;
	/** Destinations for the channel row. Authored per locale in the landing
	 * entry, so the layout never holds copy of its own. */
	links?: { label: string; href: string }[];
}

const { title = 'alex boulanger', description, localized = true, links = [] } = Astro.props;
const lang = Astro.currentLocale ?? 'en';

const path = Astro.url.pathname.replace(/^\/fr(?=\/|$)/, '') || '/';
const alternates = localized
	? [
			{ hreflang: 'en', href: path },
			{ hreflang: 'fr', href: `/fr${path === '/' ? '' : path}` },
		]
	: [];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
		<ClientRouter />
	</head>
	<body>
		<!--
		THESIS: the field is not a backdrop, it is the phenomenon this page measures.
		Refuses the centered-paragraph-on-full-bleed-canvas arrangement it replaced.
		OWN-WORLD: #0a0a0a ground, system mono only, hairline rules at 15% white, the
		ASCII density ramp as the only texture, #0000ff as the only hue, registration
		ticks and readout cells. No second face, no second color, no icon set.
		STORY: an evaluator meets an instrument measuring its own artifact, reads four
		true lines, and leaves for the CV or GitHub.
		FIRST VIEWPORT: identifier top-left and locale pair top-right; a hairline
		readout band of genuinely computed values, opening with the mode control; a
		framed observation plate holding the canvas, corner ticks and a live crosshair;
		the log entry bottom-left inside the plate at the largest type on the page; the
		channel row beneath. Seed and renderer are both drawn fresh on each mount.
		FORM: Station, candidate 6 of 6, seed 27ad4b60.
		FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
		-->
		<div class="chassis">
			<Header />
			<Readouts />
			<div class="plate">
				<Field />
				<div class="frame" aria-hidden="true">
					<span class="tick tl"></span>
					<span class="tick tr"></span>
					<span class="tick bl"></span>
					<span class="tick br"></span>
				</div>
				<Crosshair />
				<main>
					<slot />
				</main>
			</div>
			<Channels links={links} />
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0a0a0a;
		--fg: #ffffff;
		--glitch: #0000ff;
		--rule: rgba(255, 255, 255, 0.15);
		--dim: rgba(255, 255, 255, 0.68);
		/* Marks only: ticks and the crosshair. Never carries text. */
		--mark: rgba(255, 255, 255, 0.55);
		--gutter: clamp(0.9rem, 2.2vw, 2rem);
		--inset: clamp(1.1rem, 2.4vw, 2.25rem);
		/* Exponential ease-out; the chassis powers on, it does not bounce. */
		--ease: cubic-bezier(0.16, 1, 0.3, 1);
		color-scheme: dark;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		height: 100%;
		overflow: hidden;
		overscroll-behavior: none;
	}

	body {
		background: var(--bg);
		color: var(--fg);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		-webkit-font-smoothing: antialiased;
	}

	/* The instrument. Four bands: identifier, readout, plate, channels. The
	   plate takes every pixel the other three leave. */
	.chassis {
		position: relative;
		z-index: 1;
		height: 100dvh;
		padding: var(--gutter);
		display: grid;
		grid-template-rows: auto auto minmax(0, 1fr) auto;
	}

	/* The observation window. The readout band above sits flush against it, so
	   band and plate read as one mounted object rather than two panels. */
	.plate {
		position: relative;
		min-height: 0;
		border: 1px solid var(--rule);
		overflow: hidden;
	}

	.frame {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 2;
	}

	/* Registration ticks: two hairlines each, set inside the corners so the
	   plate reads as a measured window rather than a cropped image. */
	.tick {
		position: absolute;
		width: 13px;
		height: 13px;
	}

	.tick.tl {
		top: 9px;
		left: 9px;
		border-top: 1px solid var(--mark);
		border-left: 1px solid var(--mark);
	}

	.tick.tr {
		top: 9px;
		right: 9px;
		border-top: 1px solid var(--mark);
		border-right: 1px solid var(--mark);
	}

	.tick.bl {
		bottom: 9px;
		left: 9px;
		border-bottom: 1px solid var(--mark);
		border-left: 1px solid var(--mark);
	}

	.tick.br {
		bottom: 9px;
		right: 9px;
		border-bottom: 1px solid var(--mark);
		border-right: 1px solid var(--mark);
	}

	main {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: flex;
		align-items: flex-end;
		padding: var(--inset);
		pointer-events: none;
	}

	main :is(a, button) {
		pointer-events: auto;
	}

	/* Same inversion as link hover, so selection reads as part of the system. */
	::selection {
		background: var(--glitch);
		color: var(--fg);
	}

	/* Every link on the site is a glitch link, however it was authored —
	   <GlitchLink />, markdown, or hand-written <a>. One selector, no opt-in. */
	a {
		position: relative;
		display: inline-block;
		color: var(--fg);
		text-decoration: none;
		/* Padding is always present and cancelled by an equal negative margin,
		   so the hover block has room to sit behind the text without shifting
		   anything around it when it appears. */
		padding: 0.25em 0.45em;
		margin: -0.25em -0.45em;
		/* Scrim so the type stays readable over the field, without a bar. */
		text-shadow:
			0 0 6px var(--bg),
			0 0 14px var(--bg),
			0 0 22px var(--bg);
		/* Monospace + pre keeps scrambled glyphs on the exact same footprint,
		   so nothing reflows mid-effect. */
		white-space: pre;
	}

	a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.4em;
	}

	/* Hover inverts to a solid blue block; the scrim is dead weight over it.
	   The only motion is the one-shot ASCII scramble driven from the script. */
	a:hover,
	a:focus-visible {
		background: var(--glitch);
		color: var(--fg);
		text-shadow: none;
		outline: none;
	}

	/* The power-on. One orchestrated sequence staggered by band, not an
	   entrance per component: the plate and its frame draw left to right, the
	   readout cells decode, the log entry lands last. */
	@keyframes chassis-draw {
		from {
			clip-path: inset(0 100% 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	.plate {
		animation: chassis-draw 0.8s var(--ease) both;
	}

	.frame {
		animation: chassis-draw 0.8s var(--ease) 0.1s both;
	}

	@media (prefers-reduced-motion: reduce) {
		.plate,
		.frame {
			animation: none;
			clip-path: none;
		}
	}

	::view-transition-old(root),
	::view-transition-new(root) {
		animation: none;
		mix-blend-mode: normal;
	}
</style>

<script>
	if (!(window as any).__glitchLinks) {
		(window as any).__glitchLinks = true;

		const CHARS = '$@B%8&WM#*oahkbdpqwmZO0QLCJUYXzcvunxrjft/\\|()1{}[]?-_+~<>i!lI;:,"^`\'.';
		const DURATION = 420; // ms to fully resolve
		const TICK = 45; // ms a random glyph holds before rerolling

		const running = new Map<HTMLElement, number>();
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		let hovered: HTMLElement | null = null;

		function prepare() {
			document.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => {
				if (!a.dataset.label) a.dataset.label = a.textContent ?? '';
				if (!a.target && a.hostname && a.hostname !== location.hostname) {
					a.target = '_blank';
					a.rel = 'noopener noreferrer';
				}
			});
		}

		function settle(el: HTMLElement) {
			const id = running.get(el);
			if (id !== undefined) {
				cancelAnimationFrame(id);
				running.delete(el);
			}
			const label = el.dataset.label;
			if (label) el.textContent = label;
		}

		function scramble(el: HTMLElement) {
			const label = el.dataset.label ?? el.textContent ?? '';
			if (!label) return;

			const id = running.get(el);
			if (id !== undefined) cancelAnimationFrame(id);

			const start = performance.now();
			let lastTick = -1;

			const step = (now: number) => {
				const elapsed = now - start;
				const p = Math.min(1, elapsed / DURATION);
				const tick = (elapsed / TICK) | 0;

				// Reroll random glyphs only every TICK ms; otherwise the text
				// churns at 60fps and reads as noise rather than a decode.
				if (tick !== lastTick) {
					lastTick = tick;
					let out = '';
					for (let i = 0; i < label.length; i++) {
						const ch = label[i];
						if (ch === ' ') {
							out += ' ';
							continue;
						}
						// Characters resolve left to right across the word.
						const resolveAt = ((i + 1) / label.length) * 0.8;
						out += p >= resolveAt ? ch : CHARS[(Math.random() * CHARS.length) | 0];
					}
					el.textContent = out;
				}

				if (p < 1) {
					running.set(el, requestAnimationFrame(step));
				} else {
					settle(el);
				}
			};

			running.set(el, requestAnimationFrame(step));
		}

		function enter(target: EventTarget | null) {
			if (!(target instanceof Element)) return;
			const link = target.closest<HTMLElement>('a');
			if (!link || link === hovered) return;
			hovered = link;
			if (!reduced.matches) scramble(link);
		}

		document.addEventListener('pointerover', (e) => enter(e.target), { passive: true });
		document.addEventListener('focusin', (e) => enter(e.target));

		document.addEventListener(
			'pointerout',
			(e) => {
				if (!(e.target instanceof Element)) return;
				const link = e.target.closest<HTMLElement>('a');
				if (link && link === hovered) hovered = null;
			},
			{ passive: true }
		);

		prepare();
		document.addEventListener('astro:page-load', prepare);

		// A navigation can swap the DOM mid-scramble; drop any stale handles.
		document.addEventListener('astro:before-swap', () => {
			running.forEach((id) => cancelAnimationFrame(id));
			running.clear();
			hovered = null;
		});
	}
</script>
