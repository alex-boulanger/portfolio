---
import { ClientRouter } from 'astro:transitions';
import Field from '../components/Field.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	title?: string;
	description?: string;
	mode?: 'default' | 'article';
	previewImage?: { src: string; alt: string; width: number; height: number };
	ogType?: 'website' | 'article';
	publishedAt?: Date;
	updatedAt?: Date;
}

const defaultLinks = [
	{ label: 'cv', href: 'https://cv.alex-boulanger.dev' },
	{ label: 'github', href: 'https://github.com/alex-boulanger' },
	{ label: 'linkedin', href: 'https://linkedin.com/in/alex-boulanger' },
	{ label: 'instagram', href: 'https://www.instagram.com/alex_la_brioche' },
];

const {
	title = 'alex boulanger',
	description,
	mode = 'default',
	previewImage,
	ogType = 'website',
	publishedAt,
	updatedAt,
} = Astro.props;
const defaultDescription =
	'Full-stack developer. Six years building products end to end. Generative interfaces, healthcare, and web craft.';
const metaDescription = description ?? defaultDescription;
const site = Astro.site ?? new URL('https://alex-boulanger.dev');
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const previewImageUrl = new URL(previewImage?.src ?? '/og.png', site).toString();
const previewImageAlt = previewImage?.alt ?? 'alex boulanger website preview';
const previewImageWidth = previewImage?.width ?? 1200;
const previewImageHeight = previewImage?.height ?? 630;

---

<!doctype html>
<html lang="en" data-page-mode={mode}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark" />
		<title>{title}</title>
		<meta name="description" content={metaDescription} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="alex boulanger" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={previewImageUrl} />
		<meta property="og:image:width" content={String(previewImageWidth)} />
		<meta property="og:image:height" content={String(previewImageHeight)} />
		<meta property="og:image:alt" content={previewImageAlt} />
		{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
		{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={previewImageUrl} />
		<meta name="twitter:image:alt" content={previewImageAlt} />
		<ClientRouter />
	</head>
	<body data-page-mode={mode} data-field-static={mode === 'article' ? 'true' : undefined}>
		<!--
		Simple field, short intro, useful links.
		-->
		<div class="shell">
			<Header />
			<div class="field-frame">
				<Field />
				<main>
					<slot />
				</main>
			</div>
			<SiteFooter links={defaultLinks} />
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0a0a0a;
		--fg: #ffffff;
		--glitch: #0000ff;
		--rule: rgba(255, 255, 255, 0.15);
		--gutter: clamp(0.9rem, 2.2vw, 2rem);
		--inset: clamp(1.1rem, 2.4vw, 2.25rem);
		--ease: cubic-bezier(0.16, 1, 0.3, 1);
		color-scheme: dark;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		height: 100%;
		overflow: hidden;
		overscroll-behavior: none;
	}

	body {
		background: var(--bg);
		color: var(--fg);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		-webkit-font-smoothing: antialiased;
	}

	.shell {
		position: relative;
		z-index: 1;
		height: 100dvh;
		padding: var(--gutter);
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
	}

	.field-frame {
		position: relative;
		min-width: 0;
		min-height: 0;
		border: 1px solid var(--rule);
		overflow: hidden;
	}

	main {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		align-items: flex-end;
		padding: var(--inset);
		pointer-events: none;
	}

	main :is(a, button) {
		pointer-events: auto;
	}

	html[data-page-mode='article'],
	body[data-page-mode='article'] {
		height: auto;
		min-height: 100%;
		overflow: auto;
		overscroll-behavior: auto;
	}

	body[data-page-mode='article'] .shell {
		height: auto;
		min-height: 100dvh;
		grid-template-rows: auto minmax(calc(100dvh - 8rem), auto) auto;
	}

	body[data-page-mode='article'] .field-frame {
		overflow: clip;
		animation: none;
	}

	body[data-page-mode='article'] #field {
		position: sticky;
		top: 0;
		height: 100dvh;
		margin-bottom: -100dvh;
		opacity: 0.16;
	}

	body[data-page-mode='article'] main {
		position: relative;
		inset: auto;
		display: block;
		min-height: 100%;
		padding: 0;
		pointer-events: auto;
	}

	/* Same inversion as link hover, so selection reads as part of the system. */
	::selection {
		background: var(--glitch);
		color: var(--fg);
	}

	a {
		position: relative;
		display: inline-block;
		color: var(--fg);
		text-decoration: none;
		/* Padding is always present and cancelled by an equal negative margin,
		   so the hover block has room to sit behind the text without shifting
		   anything around it when it appears. */
		padding: 0.25em 0.45em;
		margin: -0.25em -0.45em;
		/* Scrim so the type stays readable over the field, without a bar. */
		text-shadow:
			0 0 6px var(--bg),
			0 0 14px var(--bg),
			0 0 22px var(--bg);
		white-space: pre;
	}

	a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.4em;
	}

	a:hover,
	a:focus-visible {
		background: var(--glitch);
		color: var(--fg);
		text-shadow: none;
		outline: none;
	}

	@keyframes field-draw {
		from {
			clip-path: inset(0 100% 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	.field-frame {
		animation: field-draw 0.8s var(--ease) both;
	}

	@media (prefers-reduced-motion: reduce) {
		.field-frame {
			animation: none;
			clip-path: none;
		}
	}

	::view-transition-old(root),
	::view-transition-new(root) {
		animation: none;
		mix-blend-mode: normal;
	}
</style>

<script>
	if (!(window as any).__glitchLinks) {
		(window as any).__glitchLinks = true;

		const CHARS = '$@B%8&WM#*oahkbdpqwmZO0QLCJUYXzcvunxrjft/\\|()1{}[]?-_+~<>i!lI;:,"^`\'.';
		const DURATION = 420; // ms to fully resolve
		const TICK = 45; // ms a random glyph holds before rerolling

		const running = new Map<HTMLElement, number>();
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		let hovered: HTMLElement | null = null;

		function prepare() {
			document.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => {
				if (!a.hasAttribute('data-no-scramble') && !a.dataset.label) a.dataset.label = a.textContent ?? '';
				if (!a.target && a.hostname && a.hostname !== location.hostname) {
					a.target = '_blank';
					a.rel = 'noopener noreferrer';
				}
			});
		}

		function settle(el: HTMLElement) {
			const id = running.get(el);
			if (id !== undefined) {
				cancelAnimationFrame(id);
				running.delete(el);
			}
			const label = el.dataset.label;
			if (label) el.textContent = label;
		}

		function scramble(el: HTMLElement) {
			const label = el.dataset.label ?? el.textContent ?? '';
			if (!label) return;

			const id = running.get(el);
			if (id !== undefined) cancelAnimationFrame(id);

			const start = performance.now();
			let lastTick = -1;

			const step = (now: number) => {
				const elapsed = now - start;
				const p = Math.min(1, elapsed / DURATION);
				const tick = (elapsed / TICK) | 0;

				if (tick !== lastTick) {
					lastTick = tick;
					let out = '';
					for (let i = 0; i < label.length; i++) {
						const ch = label[i];
						if (ch === ' ') {
							out += ' ';
							continue;
						}
						const resolveAt = ((i + 1) / label.length) * 0.8;
						out += p >= resolveAt ? ch : CHARS[(Math.random() * CHARS.length) | 0];
					}
					el.textContent = out;
				}

				if (p < 1) {
					running.set(el, requestAnimationFrame(step));
				} else {
					settle(el);
				}
			};

			running.set(el, requestAnimationFrame(step));
		}

		function enter(target: EventTarget | null) {
			if (!(target instanceof Element)) return;
			const link = target.closest<HTMLElement>('a');
			if (!link || link.hasAttribute('data-no-scramble') || link === hovered) return;
			hovered = link;
			if (!reduced.matches) scramble(link);
		}

		document.addEventListener('pointerover', (e) => enter(e.target), { passive: true });
		document.addEventListener('focusin', (e) => enter(e.target));

		document.addEventListener(
			'pointerout',
			(e) => {
				if (!(e.target instanceof Element)) return;
				const link = e.target.closest<HTMLElement>('a');
				if (link && link === hovered) hovered = null;
			},
			{ passive: true }
		);

		prepare();
		document.addEventListener('astro:page-load', prepare);

		document.addEventListener('astro:before-swap', () => {
			running.forEach((id) => cancelAnimationFrame(id));
			running.clear();
			hovered = null;
		});
	}
</script>
