---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PersonalProjects from '../components/PersonalProjects.astro';

const projects = (await getCollection('personalProjects'))
	.filter((entry) => entry.id.startsWith('en/'))
	.sort((a, b) => a.data.order - b.data.order);
---

<Base
	title="personal projects — alex boulanger"
	description="Personal projects by Alex Boulanger: Serein Devices and Framefield."
>
	<PersonalProjects locale="en" projects={projects} />
</Base>
