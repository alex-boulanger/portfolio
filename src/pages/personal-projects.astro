---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PersonalProjects from '../components/PersonalProjects.astro';

const projects = (await getCollection('personalProjects')).sort((a, b) => a.data.order - b.data.order);
---

<Base
	title="personal projects — alex boulanger"
	description="Personal projects by Alex Boulanger: Modulartype, Serein Devices, Framefield, and generative pen plotting."
>
	<PersonalProjects projects={projects} />
</Base>
