---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PersonalProjects from '../../components/PersonalProjects.astro';

const projects = (await getCollection('personalProjects'))
	.filter((entry) => entry.id.startsWith('fr/'))
	.sort((a, b) => a.data.order - b.data.order);
---

<Base
	title="projets perso — alex boulanger"
	description="Projets perso d'Alex Boulanger : Serein Devices et Framefield."
>
	<PersonalProjects locale="fr" projects={projects} />
</Base>
