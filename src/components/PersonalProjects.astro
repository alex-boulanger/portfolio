---
import type { CollectionEntry } from 'astro:content';

interface Props {
	projects: CollectionEntry<'personalProjects'>[];
}

const { projects } = Astro.props;
const firstMedia = projects[0]?.data.media[0];

const copy = {
	media: 'Project image',
	tech: 'Built with',
} as const;
---

<section class="personal-projects" data-field-shadow data-project-preview>
	<div class="projects">
		{
			projects.map((project, projectIndex) => (
				<article class="project" style={`--project-delay: ${0.18 + projectIndex * 0.1}s`}>
					<div class="project-heading">
						<h2>
							<a href={project.data.href}>
								{project.data.title.split(' ').map((word, wordIndex, words) => (
									<>
										<span>{word}</span>{wordIndex < words.length - 1 ? ' ' : null}
									</>
								))}
							</a>
						</h2>
					</div>

					<div class="project-details">
						<p class="description">{project?.body?.trim()}</p>
						{project.data.tech.length > 0 && (
							<p class="tech">
								<span>{copy.tech}</span>
								{project.data.tech.join(' · ')}
							</p>
						)}
						<a class="project-link" href={project.data.href}>
							{project.data.cta}
							{/^https?:\/\//.test(project.data.href) && <span aria-hidden="true">↗</span>}
						</a>
					</div>

					<div class="media" aria-label={`${project.data.title} ${copy.media}`}>
						{project.data.media.map((item, mediaIndex) => (
								<figure class="media-item">
									<a
										class="media-link"
										href={project.data.href}
										data-no-scramble
										data-preview-src={item.src}
										aria-label={`${project.data.cta}: ${project.data.title}`}
									>
										<img
											src={item.src}
											alt={item.alt}
											width={item.width}
											height={item.height}
											loading={projectIndex === 0 && mediaIndex === 0 ? 'eager' : 'lazy'}
											decoding="async"
											draggable="false"
										/>
									</a>
								</figure>
						))}
					</div>
				</article>
			))
		}
	</div>

	{
		firstMedia && (
			<figure class="floating-preview" aria-hidden="true">
				<img src={firstMedia.src} alt="" data-preview-image />
			</figure>
		)
	}
</section>

<style>
	.personal-projects {
		position: absolute;
		inset: 0;
		overflow-x: hidden;
		overflow-y: auto;
		padding: var(--inset);
		pointer-events: auto;
		scrollbar-color: var(--rule) transparent;
		scrollbar-width: thin;
		text-shadow: 0 0 10px var(--bg);
	}

	.project {
		width: min(100%, 86rem);
		margin-inline: auto;
	}

	.tech {
		font-size: 0.6875rem;
		font-weight: 400;
		letter-spacing: 0.16em;
		text-transform: lowercase;
	}

	.projects {
		display: grid;
		gap: clamp(3rem, 7vh, 5rem);
		padding-top: clamp(1rem, 3vh, 2rem);
		padding-bottom: clamp(2rem, 9vh, 6rem);
	}

	.project {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
		column-gap: clamp(2rem, 7vw, 7rem);
		row-gap: clamp(1.5rem, 3vh, 2.5rem);
		animation: projects-in 0.65s var(--ease) var(--project-delay) both;
	}

	.project + .project {
		border-top: 1px solid var(--rule);
		padding-top: clamp(2rem, 5vh, 3.5rem);
	}

	.project-heading {
		min-width: 0;
	}

	h2 {
		margin: 0;
		font-size: clamp(2rem, 6.7vw, 6.25rem);
		font-weight: 400;
		line-height: 0.88;
		letter-spacing: -0.055em;
		text-wrap: balance;
	}

	h2 a {
		display: block;
		width: 100%;
		white-space: normal;
	}

	.project-details {
		display: flex;
		min-height: 100%;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.35rem;
		padding-top: 0.3rem;
	}

	.description {
		max-width: 38ch;
		margin: 0;
		font-size: clamp(0.875rem, 0.55vw + 0.7rem, 1.08rem);
		line-height: 1.7;
		letter-spacing: 0.025em;
	}

	.tech {
		max-width: 50ch;
		margin: 0;
		color: rgba(255, 255, 255, 0.72);
		line-height: 1.8;
		text-transform: none;
	}

	.tech span {
		display: block;
		margin-bottom: 0.2rem;
		color: rgba(255, 255, 255, 0.42);
		text-transform: lowercase;
	}

	.project-link {
		margin-top: auto;
		font-size: 0.6875rem;
		letter-spacing: 0.13em;
		text-transform: lowercase;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.4em;
	}

	.project-link span {
		display: inline-block;
		margin-left: 0.3em;
	}

	.media {
		grid-column: 1 / -1;
		display: flex;
		gap: clamp(0.65rem, 1.3vw, 1.15rem);
		align-items: start;
		justify-self: start;
		width: fit-content;
		max-width: 100%;
	}

	.media-item {
		flex: 0 1 auto;
		min-width: 0;
		margin: 0;
	}

	.media-link {
		display: block;
		width: fit-content;
		max-width: 100%;
		padding: 0;
		margin: 0;
		background: var(--bg);
		outline: 1px solid oklch(1 0 0 / 0.1);
		outline-offset: -1px;
		text-shadow: none;
		white-space: normal;
		transition-property: opacity, outline-color;
		transition-duration: 150ms;
		transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
	}

	.media-link:hover,
	.media-link:focus-visible {
		background: var(--bg);
		outline-color: var(--glitch);
		opacity: 0.7;
	}

	.media-link:active {
		opacity: 0.72;
	}

	.media-link img {
		display: block;
		width: auto;
		max-width: 100%;
		max-height: min(30vh, 18rem);
		height: auto;
		filter: saturate(0.92) contrast(1.04);
	}

	.floating-preview {
		position: fixed;
		z-index: 5;
		left: var(--preview-x, 64vw);
		top: var(--preview-y, 42vh);
		width: min(24vw, 20rem);
		margin: 0;
		background: var(--bg);
		opacity: 0;
		filter: blur(4px);
		outline: 1px solid oklch(1 0 0 / 0.1);
		outline-offset: -1px;
		transform: translate3d(-50%, -50%, 0) rotate(var(--preview-rotate, 0deg)) scale(0.96);
		pointer-events: none;
		transition-property: opacity, filter, transform;
		transition-duration: 160ms;
		transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
	}

	.personal-projects:has(.media-link:hover) .floating-preview,
	.personal-projects:has(.media-link:focus-visible) .floating-preview {
		opacity: 1;
		filter: blur(0);
		transform: translate3d(-50%, -50%, 0) rotate(var(--preview-rotate, 0deg)) scale(1);
	}

	.floating-preview img {
		display: block;
		width: 100%;
		height: auto;
		filter: saturate(0.96) contrast(1.08);
	}

	@keyframes projects-in {
		from {
			opacity: 0;
			transform: translateY(0.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 760px) {
		.personal-projects {
			padding: clamp(1rem, 5vw, 1.4rem);
		}

		.projects {
			gap: 2.75rem;
			padding-top: clamp(1.25rem, 5vh, 2rem);
		}

		.project {
			display: block;
		}

		.project + .project {
			padding-top: 2rem;
		}

		.project-heading {
			min-width: 0;
		}

		h2 {
			font-size: clamp(2.35rem, 13vw, 4.75rem);
			line-height: 0.92;
			min-width: 0;
		}

		h2 span {
			display: block;
		}

		.project-details {
			min-height: 0;
			margin: 1.25rem 0 1.5rem;
		}

		.project-link {
			margin-top: 0.35rem;
		}

		.media {
			display: flex;
			width: auto;
			gap: 0.75rem;
			overflow-x: auto;
			overflow-y: hidden;
			margin-right: calc(-1 * clamp(1rem, 5vw, 1.4rem));
			padding: 1px clamp(1rem, 5vw, 1.4rem) 0.5rem 1px;
			overscroll-behavior-inline: contain;
			scroll-snap-type: inline proximity;
			touch-action: pan-x pan-y;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
		}

		.media::-webkit-scrollbar {
			display: none;
		}

		.media-item {
			flex: 0 0 auto;
			width: auto;
			max-width: 82vw;
			scroll-snap-align: start;
		}

		.media-link img {
			width: auto;
			max-width: none;
			max-height: none;
			height: clamp(12rem, 52vw, 18rem);
			user-select: none;
			-webkit-user-drag: none;
		}

		.floating-preview {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project {
			animation: none;
		}

		.media-link,
		.floating-preview {
			transition: none;
		}
	}
</style>

<script>
	function setupProjectPreview() {
		const root = document.querySelector<HTMLElement>('[data-project-preview]');
		if (!root || root.dataset.previewReady) return;
		root.dataset.previewReady = 'true';

		const preview = root.querySelector<HTMLImageElement>('[data-preview-image]');
		const controls = Array.from(root.querySelectorAll<HTMLElement>('[data-preview-src]'));

		const setPreview = (control: HTMLElement, index: number) => {
			if (!preview) return;
			const src = control.dataset.previewSrc;
			if (src && preview.getAttribute('src') !== src) preview.src = src;
			root.style.setProperty('--preview-rotate', `${index % 2 === 0 ? -1.5 : 1.5}deg`);
		};

		root.addEventListener(
			'pointermove',
			(event) => {
				root.style.setProperty('--preview-x', `${event.clientX}px`);
				root.style.setProperty('--preview-y', `${event.clientY}px`);
			},
			{ passive: true }
		);

		controls.forEach((control, index) => {
			control.addEventListener('pointerenter', () => setPreview(control, index));
			control.addEventListener('focus', () => {
				const rect = control.getBoundingClientRect();
				root.style.setProperty('--preview-x', `${rect.left + rect.width / 2}px`);
				root.style.setProperty('--preview-y', `${rect.top + rect.height / 2}px`);
				setPreview(control, index);
			});
		});
	}

	setupProjectPreview();
	document.addEventListener('astro:page-load', setupProjectPreview);
</script>
