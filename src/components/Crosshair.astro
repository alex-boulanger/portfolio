---
// Two hairlines tracking the pointer across the plate. The numeric readout
// they produce is not rendered next to the cursor — it lands in the fixed cell
// in the channel row, the way an instrument reports to its panel rather than
// floating a tooltip over the thing being observed.
//
// Fine pointers only: there is no hover on touch, so on a phone this never
// mounts and nothing depends on it.
---

<div class="cross" aria-hidden="true">
	<span class="h"></span>
	<span class="v"></span>
</div>

<style>
	.cross {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.25s var(--ease);
	}

	.cross[data-on='true'] {
		opacity: 1;
	}

	.h,
	.v {
		position: absolute;
		background: var(--mark);
	}

	.h {
		left: 0;
		right: 0;
		height: 1px;
		transform: translateY(var(--y, -100px));
	}

	.v {
		top: 0;
		bottom: 0;
		width: 1px;
		transform: translateX(var(--x, -100px));
	}

	/* No pointer to track. */
	@media (hover: none), (pointer: coarse) {
		.cross {
			display: none;
		}
	}
</style>

<script>
	if (!(window as any).__crosshair) {
		(window as any).__crosshair = true;

		const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
		let raf = 0;
		let cx = 0;
		let cy = 0;
		let inside = false;

		function els() {
			return {
				cross: document.querySelector<HTMLElement>('.cross'),
				plate: document.querySelector<HTMLElement>('.plate'),
				ang: document.querySelector<HTMLElement>('[data-vec="ang"]'),
				den: document.querySelector<HTMLElement>('[data-vec="den"]'),
			};
		}

		function clear() {
			const { cross, ang, den } = els();
			if (cross) cross.dataset.on = 'false';
			// Dots rather than zeroes: no reading is not a reading of nothing.
			if (ang) ang.textContent = '···.·°';
			if (den) den.textContent = '·.···';
		}

		function paint() {
			raf = 0;
			const { cross, plate, ang, den } = els();
			const field = (window as any).__field;
			if (!cross || !plate || !field) return;

			const rect = plate.getBoundingClientRect();
			const x = cx - rect.left;
			const y = cy - rect.top;

			inside = x >= 0 && y >= 0 && x <= rect.width && y <= rect.height;
			cross.dataset.on = String(inside);
			if (!inside) {
				clear();
				return;
			}

			cross.style.setProperty('--x', `${Math.round(x)}px`);
			cross.style.setProperty('--y', `${Math.round(y)}px`);

			// Normalized to a compass turn so the number means something to
			// read; the radians are the field's, unmodified.
			const a = field.angleAt(x, y);
			let deg = ((a * 180) / Math.PI) % 360;
			if (deg < 0) deg += 360;

			if (ang) ang.textContent = `${deg.toFixed(1).padStart(5, '0')}°`;
			if (den) den.textContent = field.densityAt(x, y).toFixed(3);
		}

		window.addEventListener(
			'pointermove',
			(e) => {
				if (!fine.matches || e.pointerType === 'touch') return;
				cx = e.clientX;
				cy = e.clientY;
				if (!raf) raf = requestAnimationFrame(paint);
			},
			{ passive: true }
		);

		window.addEventListener('pointerleave', clear);
		document.addEventListener('astro:page-load', clear);
	}
</script>
