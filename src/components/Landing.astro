---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'landing'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<section class="log" data-field-shadow>
	<Content />
</section>

<style>
	.log {
		max-width: 62ch;
		font-size: clamp(0.8125rem, 0.55vw + 0.6rem, 1rem);
		line-height: 1.95;
		letter-spacing: 0.035em;
		color: var(--fg);
		/* The field already recedes here — the block is marked
		   `data-field-shadow`, so the simulation dims itself underneath. This
		   is only the short stop that covers the feathered edge; the heavy
		   three-stop scrim the block used to need now reads as fog. */
		text-shadow: 0 0 10px var(--bg);
		/* Lands last in the power-on: plate draws, readouts decode, log arrives. */
		animation: log-in 0.7s var(--ease) 0.75s both;
	}

	/* Markdown output isn't scoped by Astro, so paragraphs need :global. */
	.log :global(p) {
		margin: 0 0 1.5em;
		text-wrap: pretty;
	}

	.log :global(p:last-child) {
		margin-bottom: 0;
	}

	@keyframes log-in {
		from {
			opacity: 0;
			transform: translateY(0.5rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.log {
			animation: none;
		}
	}

	@media (max-width: 600px) {
		.log {
			line-height: 1.85;
		}
	}
</style>
