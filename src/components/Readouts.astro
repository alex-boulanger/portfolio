---
// The instrument band, cut back to what the visitor can act on or verify: the
// renderer currently running, and the seed it was drawn with. Grid size, mean
// density and local time were readings nobody needed — an instrument that
// reports everything it can measure is a dashboard, not a design.
//
// Both values are real. Nothing here is authored, and nothing here is a claim
// about Alex; inventing a metric would be the one way this structure could lie.
//
// The seed cell is aria-hidden: it identifies a decorative canvas and means
// nothing without sight of it. The mode control is not, because it is a real
// control with a real effect.
const locale = Astro.currentLocale ?? 'en';

const t =
	locale === 'fr'
		? { mode: 'mode', seed: 'graine', cycle: 'Changer le mode de rendu du champ' }
		: { mode: 'mode', seed: 'seed', cycle: 'Change the field render mode' };

// Display names per locale. The renderer ids stay English in the code; these
// are what the chassis shows.
const modeNames =
	locale === 'fr'
		? { flow: 'flux', dither: 'trame', raster: 'raster', moire: 'moiré' }
		: { flow: 'flow', dither: 'dither', raster: 'raster', moire: 'moiré' };
---

<div class="band">
	<button type="button" class="mode" aria-label={t.cycle} data-mode-names={JSON.stringify(modeNames)}>
		<i>{t.mode}</i><b data-cell="mode" aria-live="polite">····</b>
	</button>
	<span class="cell" aria-hidden="true"><i>{t.seed}</i><b data-cell="seed">····</b></span>
</div>

<style>
	/* Flush against the plate below it: band and plate are one mounted
	   instrument, not two stacked panels. */
	.band {
		display: flex;
		align-items: baseline;
		gap: clamp(0.9rem, 2.6vw, 2.5rem);
		padding: 0.55rem 0.85rem;
		border: 1px solid var(--rule);
		border-bottom: none;
		font-size: 0.6875rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		white-space: nowrap;
		overflow: hidden;
	}

	.cell,
	.mode {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5em;
		min-width: 0;
	}

	/* Label and value differ by tone, never by size — at this scale a second
	   size step would just look like a mistake. Both clear 4.5:1. */
	i {
		font-style: normal;
		color: var(--dim);
	}

	b {
		font-weight: 400;
		color: var(--fg);
		/* Values change every tick; `pre` holds the glyph footprint so the
		   row never reflows as digits swap. */
		white-space: pre;
	}

	/* The system's one interactive treatment, reused rather than reinvented:
	   the same inversion a link takes, on the same padding-cancelled box. A
	   mode selector is native to an instrument; a styled button would not be. */
	.mode {
		appearance: none;
		background: none;
		border: 0;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		color: var(--fg);
		cursor: pointer;
		padding: 0.25em 0.45em;
		margin: -0.25em -0.45em;
	}

	.mode:hover,
	.mode:focus-visible {
		background: var(--glitch);
		outline: none;
	}

	.mode:hover i,
	.mode:focus-visible i {
		color: var(--fg);
	}

	@media (max-width: 520px) {
		.band {
			gap: 1.1rem;
			padding: 0.5rem 0.65rem;
			letter-spacing: 0.1em;
		}
	}
</style>

<script>
	// Part of the power-on: the cells decode out of the same glyph alphabet the
	// field draws with, then hand over to live values. One sequence, not a
	// second effect — the plate draws, the cells resolve, the log lands. The
	// same decode replays on a mode change, so swapping the phenomenon reads as
	// the instrument re-acquiring rather than a value blinking.
	if (!(window as any).__readouts) {
		(window as any).__readouts = true;

		const CHARS = '$@B%8&WM#*oahkbdpqwmZO0QLCJUYXzcvunxrjft/\\|()1{}[]?-_+~<>i!lI;:,"^`\'.';
		const DECODE = 620; // ms for a cell to resolve
		const STAGGER = 70; // ms between cells
		const TICK = 45;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

		let timer = 0;
		// Cells mid-decode own their own text; the live tick must not fight it.
		const decoding = new Set<HTMLElement>();

		function modeNames(): Record<string, string> {
			const el = document.querySelector<HTMLElement>('[data-mode-names]');
			try {
				return el?.dataset.modeNames ? JSON.parse(el.dataset.modeNames) : {};
			} catch {
				return {};
			}
		}

		function read(key: string) {
			const f = (window as any).__field;
			switch (key) {
				case 'mode': {
					if (!f) return '····';
					const names = modeNames();
					return names[f.mode] ?? f.mode;
				}
				case 'seed':
					return f ? f.seedHex : '—';
				default:
					return '—';
			}
		}

		function cells() {
			return Array.from(document.querySelectorAll<HTMLElement>('[data-cell]'));
		}

		function live() {
			cells().forEach((el) => {
				if (decoding.has(el)) return;
				const key = el.dataset.cell;
				if (key) el.textContent = read(key);
			});
		}

		// Decode against the value the cell is about to hold, so the footprint
		// it settles into is the footprint it churned at.
		function decode(el: HTMLElement, target: string, delay: number) {
			const start = performance.now() + delay;
			let lastTick = -1;
			decoding.add(el);

			// The animation runs on rAF, which never fires while the tab is
			// hidden. Land the real value first so a cell can never be stranded
			// mid-decode, and keep a timer that settles it if rAF stalls.
			el.textContent = target;
			const guard = window.setTimeout(() => {
				el.textContent = target;
				decoding.delete(el);
			}, delay + DECODE + 400);

			const finish = () => {
				window.clearTimeout(guard);
				el.textContent = target;
				decoding.delete(el);
			};

			const step = (now: number) => {
				const elapsed = now - start;
				if (elapsed < 0) {
					requestAnimationFrame(step);
					return;
				}
				const p = Math.min(1, elapsed / DECODE);
				const tick = (elapsed / TICK) | 0;

				if (tick !== lastTick) {
					lastTick = tick;
					let out = '';
					for (let i = 0; i < target.length; i++) {
						const ch = target[i];
						if (ch === ' ') {
							out += ' ';
							continue;
						}
						const resolveAt = ((i + 1) / target.length) * 0.85;
						out += p >= resolveAt ? ch : CHARS[(Math.random() * CHARS.length) | 0];
					}
					el.textContent = out;
				}

				if (p < 1) requestAnimationFrame(step);
				else finish();
			};

			requestAnimationFrame(step);
		}

		function boot() {
			window.clearInterval(timer);
			decoding.clear();

			// The field publishes its grid on first resize; until then there is
			// nothing true to show, so wait rather than print a placeholder.
			const ready = () => Boolean((window as any).__field?.cols);

			const begin = () => {
				if (reduced.matches) {
					live();
				} else {
					cells().forEach((el, i) => {
						const key = el.dataset.cell;
						if (key) decode(el, read(key), i * STAGGER);
					});
				}
				// Nothing in the band ticks any more: the seed is fixed for the
				// mount and the mode is event-driven. One late sweep catches the
				// values that were not ready at first paint, then it stops.
				timer = window.setInterval(live, 400);
				window.setTimeout(() => window.clearInterval(timer), 4000);
			};

			if (ready()) {
				begin();
			} else {
				let tries = 0;
				const wait = window.setInterval(() => {
					if (ready() || ++tries > 60) {
						window.clearInterval(wait);
						begin();
					}
				}, 50);
			}
		}

		// Delegated, so the control survives client-side navigation.
		document.addEventListener('click', (e) => {
			if (!(e.target instanceof Element)) return;
			if (!e.target.closest('.mode')) return;
			document.dispatchEvent(new CustomEvent('field:cycle'));
		});

		document.addEventListener('field:mode', () => {
			const el = document.querySelector<HTMLElement>('[data-cell="mode"]');
			if (!el) return;
			const target = read('mode');
			if (reduced.matches) el.textContent = target;
			else decode(el, target, 0);
		});

		boot();
		document.addEventListener('astro:page-load', boot);
		document.addEventListener('astro:before-swap', () => window.clearInterval(timer));
	}
</script>
