---
// ASCII flowfield. It fills the observation plate rather than the viewport:
// the plate gives it an edge, which is what makes it an artifact under
// measurement instead of wallpaper. Marked transition:persist so navigation
// never restarts the simulation.
//
// It also publishes what it is doing to `window.__field`, which is the only
// source the readouts and the crosshair are allowed to draw from. Every value
// on the chassis is measured here; none is authored.
---

<canvas id="flowfield" transition:persist aria-hidden="true"></canvas>

<style>
	#flowfield {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		z-index: 0;
		pointer-events: none;
	}
</style>

<script>
	// Guard: with ClientRouter this module evaluates once, but the flag also
	// protects against a stray re-run leaving two loops on one canvas.
	if (!(window as any).__flowfield) {
		(window as any).__flowfield = true;
		start();
	}

	function start() {
		const el = document.getElementById('flowfield');
		if (!(el instanceof HTMLCanvasElement)) return;
		const canvas: HTMLCanvasElement = el;
		const ctx = canvas.getContext('2d', { alpha: false })!;

		// Density ramp, darkest-first. Reversed so index 0 is the faintest
		// glyph, with a leading space for genuinely empty cells.
		const RAMP =
			' ' +
			'$@B%8&WM#*oahkbdpqwmZO0QLCJUYXzcvunxrjft/\\|()1{}[]?-_+~<>i!lI;:,"^`\'.'
				.split('')
				.reverse()
				.join('');
		const FONT = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
		const BG = '#0a0a0a';
		const FG = '#c0c0c0';

		// Glyph density carries most of the tone; the greys on top give the
		// field depth, so cores read as foreground and haze recedes. The band
		// runs from just off the ground to FG: a narrow band of midtones is
		// what makes a field like this read flat, because every cell lands in
		// the same tonal register no matter what the simulation is doing.
		const SHADE_FLOOR = '#161616';
		const SHADES = buildShades(SHADE_FLOOR, FG, 12);

		function buildShades(from: string, to: string, steps: number) {
			const a = parseInt(from.slice(1), 16);
			const b = parseInt(to.slice(1), 16);
			const out: string[] = [];
			for (let i = 0; i < steps; i++) {
				const k = steps === 1 ? 1 : i / (steps - 1);
				const ch = (shift: number) => {
					const av = (a >> shift) & 255;
					const bv = (b >> shift) & 255;
					return Math.round(av + (bv - av) * k);
				};
				out.push(`rgb(${ch(16)}, ${ch(8)}, ${ch(0)})`);
			}
			return out;
		}

		// v(0..1) -> ramp index. Gamma > 1 keeps low densities down at the faint
		// end of the ramp so only real currents climb toward $@B%. It stays
		// mild: the tonal range is carried by the shade band below, and pushing
		// gamma up as well empties the field instead of deepening it.
		const GAMMA = 1.3;
		const LUT = new Uint8Array(256);
		const SHADE_LUT = new Uint8Array(256);
		for (let i = 0; i < 256; i++) {
			LUT[i] = Math.min(RAMP.length - 1, (Math.pow(i / 255, GAMMA) * RAMP.length) | 0);
			SHADE_LUT[i] = Math.min(SHADES.length - 1, (Math.pow(i / 255, GAMMA) * SHADES.length) | 0);
		}

		// ---- perlin ---------------------------------------------------------
		// The permutation seed. Published to the chassis as SEED, so the number
		// on screen is the number this field is actually running on.
		const SEED = 1337;
		const perm = new Uint8Array(512);
		{
			const p = new Uint8Array(256);
			for (let i = 0; i < 256; i++) p[i] = i;
			let s = SEED;
			for (let i = 255; i > 0; i--) {
				s = (s * 1664525 + 1013904223) >>> 0;
				const j = (s / 4294967296) * (i + 1) | 0;
				const t = p[i]; p[i] = p[j]; p[j] = t;
			}
			for (let i = 0; i < 512; i++) perm[i] = p[i & 255];
		}
		const fade = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);
		const lerp = (a: number, b: number, t: number) => a + t * (b - a);
		function grad(h: number, x: number, y: number, z: number) {
			h &= 15;
			const u = h < 8 ? x : y;
			const v = h < 4 ? y : h === 12 || h === 14 ? x : z;
			return ((h & 1) === 0 ? u : -u) + ((h & 2) === 0 ? v : -v);
		}
		function noise(x: number, y: number, z: number) {
			const X = Math.floor(x) & 255, Y = Math.floor(y) & 255, Z = Math.floor(z) & 255;
			x -= Math.floor(x); y -= Math.floor(y); z -= Math.floor(z);
			const u = fade(x), v = fade(y), w = fade(z);
			const A = perm[X] + Y, AA = perm[A] + Z, AB = perm[A + 1] + Z;
			const B = perm[X + 1] + Y, BA = perm[B] + Z, BB = perm[B + 1] + Z;
			return lerp(
				lerp(
					lerp(grad(perm[AA], x, y, z), grad(perm[BA], x - 1, y, z), u),
					lerp(grad(perm[AB], x, y - 1, z), grad(perm[BB], x - 1, y - 1, z), u),
					v
				),
				lerp(
					lerp(grad(perm[AA + 1], x, y, z - 1), grad(perm[BA + 1], x - 1, y, z - 1), u),
					lerp(grad(perm[AB + 1], x, y - 1, z - 1), grad(perm[BB + 1], x - 1, y - 1, z - 1), u),
					v
				),
				w
			);
		}

		// ---- tunables -------------------------------------------------------
		const NOISE_SCALE = 0.0025;   // flow feature size, in px
		const TIME_SCALE = 0.11;      // how fast the field itself evolves
		// A trail lives ~1/(1-DECAY) frames. SPEED against that window sets the
		// look: fast enough to cross many cells and streaks read as lines, slow
		// enough and they stay as drifting points.
		const SPEED = 50;             // px/s
		const DECAY = 0.976;          // trail persistence per frame
		const DEPOSIT = 0.16;         // how much a particle adds to the field per frame
		// Ambient is a floor under every cell. It used to flatten the field
		// because the shade band started at #454545, so every ambient cell
		// rendered as a visible midtone. With the band starting near the ground
		// the same grain renders almost black, which is texture rather than haze
		// — so it can stay generous.
		const AMBIENT = 0.055;         // faint background grain
		// How far the field is pushed down behind foreground type, and over how
		// many px it recovers. This is what separates the log from the field —
		// the field recedes where the type sits, rather than the type wearing a
		// glow to survive it. It is also what holds text contrast now that the
		// bright end of the ramp is genuinely bright.
		// Scaled per viewport in resize(): a 150px feather is a soft well on a
		// desktop plate and half the visible field on a phone, where the log
		// occupies most of the width to begin with.
		let shadowDepth = 0.92;
		let feather = 150;
		const RADIUS = 150;           // mouse influence, px
		const REPEL = 620;
		const WAKE = 9;               // how much cursor velocity drags the field

		let W = 0, H = 0, dpr = 1;
		let cols = 0, rows = 0, cellW = 8, cellH = 10;
		let buf = new Float32Array(0);
		let ambient = new Float32Array(0);
		// Per-cell multiplier, 1 everywhere except behind foreground type.
		let attn = new Float32Array(0);
		let px = new Float32Array(0), py = new Float32Array(0), life = new Int32Array(0);
		let count = 0;

		// Per-row scratch for the shade passes: resolved glyph + shade per cell,
		// plus each shade's column extent so a pass only draws its own span.
		let glyph = new Uint8Array(0);
		let shade = new Uint8Array(0);
		const minC = new Int32Array(SHADES.length);
		const maxC = new Int32Array(SHADES.length);

		let mx = -1e5, my = -1e5, mvx = 0, mvy = 0, hasPointer = false;
		let t = 0, last = 0, running = true;

		// Mean cell density of the last rendered frame, 0..1. Read by the
		// readout band; recomputed as a by-product of the render it already does.
		let density = 0;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

		// The chassis reads the instrument through this, never the other way
		// round. Angle is the same value the particles steer by, so the
		// crosshair reports the field rather than describing it.
		const telemetry = {
			seed: SEED,
			get cols() { return cols; },
			get rows() { return rows; },
			get density() { return density; },
			get particles() { return count; },
			/** Flow angle in radians at a plate-local point. */
			angleAt(x: number, y: number) {
				return noise(x * NOISE_SCALE, y * NOISE_SCALE, t * TIME_SCALE) * Math.PI * 3;
			},
			/** Normalized deposited density at a plate-local point, 0..1. */
			densityAt(x: number, y: number) {
				const c = (x / cellW) | 0;
				const r = (y / cellH) | 0;
				if (c < 0 || c >= cols || r < 0 || r >= rows) return 0;
				return Math.min(1, buf[r * cols + c]);
			},
		};
		(window as any).__field = telemetry;

		// Elements that have to stay readable declare themselves with
		// `data-field-shadow`; the field reads their boxes and steps its own
		// density down underneath them. Recomputed only on resize and
		// navigation — the mask is geometry, not per-frame work.
		function computeShadow() {
			if (!attn.length) return;
			attn.fill(1);

			const rect = canvas.getBoundingClientRect();
			const targets = document.querySelectorAll<HTMLElement>('[data-field-shadow]');

			targets.forEach((el) => {
				const b = el.getBoundingClientRect();
				if (b.width < 1 || b.height < 1) return;

				const x0 = b.left - rect.left;
				const y0 = b.top - rect.top;
				const x1 = x0 + b.width;
				const y1 = y0 + b.height;

				const cFrom = Math.max(0, ((x0 - feather) / cellW) | 0);
				const cTo = Math.min(cols - 1, ((x1 + feather) / cellW) | 0);
				const rFrom = Math.max(0, ((y0 - feather) / cellH) | 0);
				const rTo = Math.min(rows - 1, ((y1 + feather) / cellH) | 0);

				for (let r = rFrom; r <= rTo; r++) {
					const cy = r * cellH + cellH * 0.5;
					const dy = cy < y0 ? y0 - cy : cy > y1 ? cy - y1 : 0;

					for (let c = cFrom; c <= cTo; c++) {
						const cx = c * cellW + cellW * 0.5;
						const dx = cx < x0 ? x0 - cx : cx > x1 ? cx - x1 : 0;

						// Distance to the box, not to its centre, so a wide
						// block of copy carries an even shadow across its width.
						const d = Math.hypot(dx, dy);
						if (d >= feather) continue;

						// Smoothstep: a linear falloff leaves a visible seam
						// where the shadow ends.
						const k = 1 - d / feather;
						const v = 1 - shadowDepth * (k * k * (3 - 2 * k));
						const i = r * cols + c;
						if (v < attn[i]) attn[i] = v;
					}
				}
			});
		}

		function resize() {
			const rect = canvas.getBoundingClientRect();
			// The plate can be laid out at zero height for a frame during the
			// power-on clip; sizing to that would throw away the whole grid.
			if (rect.width < 1 || rect.height < 1) return;

			dpr = Math.min(window.devicePixelRatio || 1, 2);
			W = rect.width;
			H = rect.height;
			canvas.width = Math.round(W * dpr);
			canvas.height = Math.round(H * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			// 8px on desktop, stepping up so small screens stay legible.
			const fontSize = W < 600 ? 12 : W < 1024 ? 10 : 8;
			// The log spans nearly the full width on a phone, so the well has to
			// be tighter and shallower or it swallows the plate.
			feather = W < 600 ? 64 : W < 1024 ? 110 : 150;
			shadowDepth = W < 600 ? 0.84 : 0.92;
			ctx.font = `${fontSize}px ${FONT}`;
			ctx.textBaseline = 'top';
			cellW = ctx.measureText('M').width || fontSize * 0.6;
			cellH = fontSize * 1.15;

			cols = Math.ceil(W / cellW) + 1;
			rows = Math.ceil(H / cellH) + 1;

			buf = new Float32Array(cols * rows);
			ambient = new Float32Array(cols * rows);
			attn = new Float32Array(cols * rows);
			glyph = new Uint8Array(cols);
			shade = new Uint8Array(cols);
			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					ambient[r * cols + c] = (noise(c * 0.028, r * 0.055, 0) + 1) * 0.5;
				}
			}

			// Denser than the field carried before: the currents are what the
			// plate is for, and at the old occupancy a wide tonal band just
			// spreads a few streaks over a lot of empty ground.
			// One trace per ~30 cells, so a phone's small grid gets the same
			// visual density as a desktop one. The floor stays low on purpose:
			// a fixed floor of a few hundred is meaningless on a 2,300-cell
			// grid and saturates the whole plate into a solid block.
			count = Math.max(80, Math.min(2800, ((cols * rows) / 30) | 0));
			px = new Float32Array(count);
			py = new Float32Array(count);
			life = new Int32Array(count);
			for (let i = 0; i < count; i++) respawn(i);

			computeShadow();
		}

		function respawn(i: number) {
			px[i] = Math.random() * W;
			py[i] = Math.random() * H;
			life[i] = 120 + ((Math.random() * 260) | 0);
		}

		function step(dt: number) {
			t += dt;
			for (let i = 0; i < count; i++) {
				const a = noise(px[i] * NOISE_SCALE, py[i] * NOISE_SCALE, t * TIME_SCALE) * Math.PI * 3;
				let vx = Math.cos(a) * SPEED;
				let vy = Math.sin(a) * SPEED;

				const dx = px[i] - mx, dy = py[i] - my;
				const d2 = dx * dx + dy * dy;
				if (d2 < RADIUS * RADIUS) {
					const d = Math.sqrt(d2) || 1;
					const f = 1 - d / RADIUS;
					vx += (dx / d) * f * REPEL + mvx * f * WAKE;
					vy += (dy / d) * f * REPEL + mvy * f * WAKE;
				}

				let x = px[i] + vx * dt;
				let y = py[i] + vy * dt;
				if (x < 0) x += W; else if (x >= W) x -= W;
				if (y < 0) y += H; else if (y >= H) y -= H;
				px[i] = x; py[i] = y;

				const c = (x / cellW) | 0;
				const r = (y / cellH) | 0;
				if (c >= 0 && c < cols && r >= 0 && r < rows) buf[r * cols + c] += DEPOSIT;

				if (--life[i] <= 0) respawn(i);
			}

			mvx *= 0.86;
			mvy *= 0.86;
		}

		function render() {
			ctx.fillStyle = BG;
			ctx.fillRect(0, 0, W, H);

			// Ambient grain drifts slowly so empty regions aren't dead.
			const ox = (t * 2) | 0, oy = (t * 0.8) | 0;
			const shadeCount = SHADES.length;
			let sum = 0;

			for (let r = 0; r < rows; r++) {
				const base = r * cols;
				const arow = ((r + oy) % rows) * cols;

				for (let s = 0; s < shadeCount; s++) {
					minC[s] = cols;
					maxC[s] = -1;
				}

				// Pass 1: decay the buffer and resolve each cell once.
				for (let c = 0; c < cols; c++) {
					const raw = buf[base + c] * DECAY;
					buf[base + c] = raw;
					let v = raw + ambient[arow + ((c + ox) % cols)] * AMBIENT;
					if (v > 1) v = 1;

					// DENS reports the field, so it is read before the shadow:
					// the mask is how the field is displayed under type, not
					// something the simulation is doing.
					sum += v;
					v *= attn[base + c];

					const q = (v * 255) | 0;
					const gi = LUT[q];
					glyph[c] = gi;
					if (gi === 0) {
						shade[c] = 255; // blank cell, drawn by nobody
						continue;
					}
					const si = SHADE_LUT[q];
					shade[c] = si;
					if (c < minC[si]) minC[si] = c;
					if (c > maxC[si]) maxC[si] = c;
				}

				// Pass 2: one fillText per shade present in this row. Cells
				// belonging to other shades become spaces, which cost nothing
				// and keep every glyph on its exact column.
				const y = r * cellH;
				for (let s = 0; s < shadeCount; s++) {
					const from = minC[s];
					const to = maxC[s];
					if (to < from) continue;
					let line = '';
					for (let c = from; c <= to; c++) {
						line += shade[c] === s ? RAMP[glyph[c]] : ' ';
					}
					ctx.fillStyle = SHADES[s];
					ctx.fillText(line, from * cellW, y);
				}
			}

			density = cols && rows ? sum / (cols * rows) : 0;
		}

		function frame(now: number) {
			if (!running) return;
			const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016);
			last = now;
			step(dt);
			render();
			requestAnimationFrame(frame);
		}

		function boot() {
			resize();
			if (reduced.matches) {
				// Settle the field, then hold a single static frame.
				for (let i = 0; i < 240; i++) step(0.016);
				render();
				return;
			}
			running = true;
			last = 0;
			requestAnimationFrame(frame);
		}

		// The plate resizes on viewport changes and on the power-on clip
		// settling, neither of which a window resize listener would catch.
		let resizeQueued = false;
		const ro = new ResizeObserver(() => {
			if (resizeQueued) return;
			resizeQueued = true;
			requestAnimationFrame(() => {
				resizeQueued = false;
				resize();
				if (reduced.matches) render();
			});
		});
		ro.observe(canvas);

		// The log arrives on a short rise, and a navigation swaps which element
		// sits over the field. Both move the boxes the mask is cut from, and
		// neither is a resize.
		function refreshShadow() {
			computeShadow();
			if (reduced.matches) render();
		}

		window.setTimeout(refreshShadow, 1600);
		document.addEventListener('astro:page-load', () => {
			refreshShadow();
			window.setTimeout(refreshShadow, 1600);
		});

		// Pointer coordinates are plate-local: the field no longer fills the
		// viewport, so client coordinates would be offset by the chassis.
		window.addEventListener('pointermove', (e) => {
			const rect = canvas.getBoundingClientRect();
			const x = e.clientX - rect.left;
			const y = e.clientY - rect.top;
			if (hasPointer) {
				mvx = x - mx;
				mvy = y - my;
			}
			hasPointer = true;
			mx = x;
			my = y;
		}, { passive: true });

		window.addEventListener('pointerleave', () => {
			hasPointer = false;
			mx = my = -1e5;
			mvx = mvy = 0;
		});

		document.addEventListener('visibilitychange', () => {
			if (reduced.matches) return;
			if (document.hidden) {
				running = false;
			} else if (!running) {
				running = true;
				last = 0;
				requestAnimationFrame(frame);
			}
		});

		boot();
	}
</script>
