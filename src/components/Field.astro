---
// Four renderers share one cell grid, glyph ramp, shade band, and attenuation
// mask. Marked transition:persist so navigation never restarts the simulation.
---

<canvas id="field" transition:persist aria-hidden="true"></canvas>

<style>
	#field {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		z-index: 0;
		pointer-events: none;
	}
</style>

<script>
	// Guard: with ClientRouter this module evaluates once, but the flag also
	// protects against a stray re-run leaving two loops on one canvas.
	if (!(window as any).__asciiCanvasBooted) {
		(window as any).__asciiCanvasBooted = true;
		start();
	}

	function start() {
		const el = document.getElementById('field');
		if (!(el instanceof HTMLCanvasElement)) return;
		const canvas: HTMLCanvasElement = el;
		const ctx = canvas.getContext('2d', { alpha: false })!;

		// Density ramp, darkest-first. Reversed so index 0 is the faintest
		// glyph, with a leading space for genuinely empty cells.
		const RAMP =
			' ' +
			'$@B%8&WM#*oahkbdpqwmZO0QLCJUYXzcvunxrjft/\\|()1{}[]?-_+~<>i!lI;:,"^`\'.'
				.split('')
				.reverse()
				.join('');
		const FONT = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
		const BG = '#0a0a0a';
		const FG = '#c0c0c0';

		// The band runs from just off the ground to FG. A narrow band of
		// midtones is what makes a generative field read flat: every cell lands
		// in the same tonal register no matter what the simulation is doing.
		const SHADE_FLOOR = '#161616';

		// Stop spacing. The two endpoints are fixed; what varies is where the ten
		// stops between them fall. Evenly spaced stops spend as much of the ramp
		// on the extremes as on the middle, and the extremes are where tone
		// carries the least: faint haze wants to read as one dim mass and lit
		// cores as one bright mass, not as a series of steps. An S-curve
		// compresses both ends and spends the resolution across the middle,
		// which is where structure actually lives.
		//
		// Not a perceptual correction — sRGB steps across this particular band
		// are already close to even in L*. This is a compositional choice.
		// 0 leaves the stops linear, 1 is a full smoothstep.
		const SHADE_CURVE = 0.55;
		const SHADES = buildShades(SHADE_FLOOR, FG, 12);

		function buildShades(from: string, to: string, steps: number) {
			const a = parseInt(from.slice(1), 16);
			const b = parseInt(to.slice(1), 16);
			const out: string[] = [];
			for (let i = 0; i < steps; i++) {
				const k = steps === 1 ? 1 : i / (steps - 1);
				const s = k * k * (3 - 2 * k);
				const e = k + (s - k) * SHADE_CURVE;
				const ch = (shift: number) => {
					const av = (a >> shift) & 255;
					const bv = (b >> shift) & 255;
					return Math.round(av + (bv - av) * e);
				};
				out.push(`rgb(${ch(16)}, ${ch(8)}, ${ch(0)})`);
			}
			return out;
		}

		// v(0..1) -> ramp index. Gamma > 1 keeps low densities down at the faint
		// end so only real structure climbs toward $@B%. It stays mild: the
		// tonal range is carried by the shade band, and pushing gamma up as well
		// empties the field instead of deepening it.
		const GAMMA = 1.3;
		const LUT = new Uint8Array(256);
		const SHADE_LUT = new Uint8Array(256);
		for (let i = 0; i < 256; i++) {
			LUT[i] = Math.min(RAMP.length - 1, (Math.pow(i / 255, GAMMA) * RAMP.length) | 0);
			SHADE_LUT[i] = Math.min(SHADES.length - 1, (Math.pow(i / 255, GAMMA) * SHADES.length) | 0);
		}

		const seed = 1 + ((Math.random() * 0xffff) | 0);

		function mulberry32(a: number) {
			return function () {
				a |= 0;
				a = (a + 0x6d2b79f5) | 0;
				let t = Math.imul(a ^ (a >>> 15), 1 | a);
				t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
				return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
			};
		}
		const rand = mulberry32(seed);

		// ---- perlin ---------------------------------------------------------
		const perm = new Uint8Array(512);
		{
			const p = new Uint8Array(256);
			for (let i = 0; i < 256; i++) p[i] = i;
			for (let i = 255; i > 0; i--) {
				const j = (rand() * (i + 1)) | 0;
				const t = p[i]; p[i] = p[j]; p[j] = t;
			}
			for (let i = 0; i < 512; i++) perm[i] = p[i & 255];
		}
		const fade = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);
		const lerp = (a: number, b: number, t: number) => a + t * (b - a);
		function grad(h: number, x: number, y: number, z: number) {
			h &= 15;
			const u = h < 8 ? x : y;
			const v = h < 4 ? y : h === 12 || h === 14 ? x : z;
			return ((h & 1) === 0 ? u : -u) + ((h & 2) === 0 ? v : -v);
		}
		function noise(x: number, y: number, z: number) {
			const X = Math.floor(x) & 255, Y = Math.floor(y) & 255, Z = Math.floor(z) & 255;
			x -= Math.floor(x); y -= Math.floor(y); z -= Math.floor(z);
			const u = fade(x), v = fade(y), w = fade(z);
			const A = perm[X] + Y, AA = perm[A] + Z, AB = perm[A + 1] + Z;
			const B = perm[X + 1] + Y, BA = perm[B] + Z, BB = perm[B + 1] + Z;
			return lerp(
				lerp(
					lerp(grad(perm[AA], x, y, z), grad(perm[BA], x - 1, y, z), u),
					lerp(grad(perm[AB], x, y - 1, z), grad(perm[BB], x - 1, y - 1, z), u),
					v
				),
				lerp(
					lerp(grad(perm[AA + 1], x, y, z - 1), grad(perm[BA + 1], x - 1, y, z - 1), u),
					lerp(grad(perm[AB + 1], x, y - 1, z - 1), grad(perm[BB + 1], x - 1, y - 1, z - 1), u),
					v
				),
				w
			);
		}

		// ---- shared grid ----------------------------------------------------
		let W = 0, H = 0, dpr = 1;
		let cols = 0, rows = 0, cellW = 8, cellH = 10;

		// What every renderer writes and the draw pass reads: one normalized
		// value per cell, 0..1.
		let field = new Float32Array(0);
		// Per-cell multiplier, 1 everywhere except behind foreground type.
		let attn = new Float32Array(0);

		let glyph = new Uint8Array(0);
		let shade = new Uint8Array(0);
		const minC = new Int32Array(SHADES.length);
		const maxC = new Int32Array(SHADES.length);

		let mx = -1e5, my = -1e5, mvx = 0, mvy = 0, hasPointer = false;
		let t = 0, last = 0, running = true;

		let shadowDepth = 0.75;
		let feather = 150;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

		// ---- renderers ------------------------------------------------------
		// Each owns its own state, allocates on resize, and writes `field`.
		// They share the ramp, shade band, mask, and pointer state.

		// FLOW — particles advected by a perlin flow field, depositing trails
		// that decay. Diffuse currents against genuine voids.
		const flow = (() => {
			const NOISE_SCALE = 0.0025, TIME_SCALE = 0.11, SPEED = 50;
			const DECAY = 0.976, DEPOSIT = 0.16, AMBIENT = 0.055;
			const RADIUS = 150, REPEL = 620, WAKE = 9;

			let px = new Float32Array(0), py = new Float32Array(0), life = new Int32Array(0);
			let ambient = new Float32Array(0);
			let count = 0;

			function respawn(i: number) {
				px[i] = rand() * W;
				py[i] = rand() * H;
				life[i] = 120 + ((rand() * 260) | 0);
			}

			return {
				label: 'flow',
				alloc() {
					ambient = new Float32Array(cols * rows);
					for (let r = 0; r < rows; r++) {
						for (let c = 0; c < cols; c++) {
							ambient[r * cols + c] = (noise(c * 0.028, r * 0.055, 0) + 1) * 0.5;
						}
					}
					// One trace per ~30 cells, so a phone's small grid gets the
					// same visual density as a desktop one. A fixed floor of a
					// few hundred saturates a 2,300-cell grid into a block.
					count = Math.max(80, Math.min(2800, ((cols * rows) / 30) | 0));
					px = new Float32Array(count);
					py = new Float32Array(count);
					life = new Int32Array(count);
					for (let i = 0; i < count; i++) respawn(i);
				},
				step(dt: number) {
					for (let i = 0; i < count; i++) {
						const a = noise(px[i] * NOISE_SCALE, py[i] * NOISE_SCALE, t * TIME_SCALE) * Math.PI * 3;
						let vx = Math.cos(a) * SPEED;
						let vy = Math.sin(a) * SPEED;

						const dx = px[i] - mx, dy = py[i] - my;
						const d2 = dx * dx + dy * dy;
						if (d2 < RADIUS * RADIUS) {
							const d = Math.sqrt(d2) || 1;
							const f = 1 - d / RADIUS;
							vx += (dx / d) * f * REPEL + mvx * f * WAKE;
							vy += (dy / d) * f * REPEL + mvy * f * WAKE;
						}

						let x = px[i] + vx * dt;
						let y = py[i] + vy * dt;
						if (x < 0) x += W; else if (x >= W) x -= W;
						if (y < 0) y += H; else if (y >= H) y -= H;
						px[i] = x; py[i] = y;

						const c = (x / cellW) | 0;
						const r = (y / cellH) | 0;
						if (c >= 0 && c < cols && r >= 0 && r < rows) field[r * cols + c] += DEPOSIT;

						if (--life[i] <= 0) respawn(i);
					}

					// Decay in place, then lay the drifting ambient grain on top.
					const ox = (t * 2) | 0, oy = (t * 0.8) | 0;
					for (let r = 0; r < rows; r++) {
						const base = r * cols;
						const arow = ((r + oy) % rows) * cols;
						for (let c = 0; c < cols; c++) {
							const decayed = field[base + c] * DECAY;
							field[base + c] = decayed;
							// Ambient rides on the output only; folding it back
							// into the deposit buffer would compound every frame.
							const v = decayed + ambient[arow + ((c + ox) % cols)] * AMBIENT;
							fieldOut[base + c] = v > 1 ? 1 : v;
						}
					}
				},
			};
		})();

		// DITHER — domain-warped fbm quantized through an 8x8 Bayer matrix.
		// The ordered threshold is the point: it produces the crosshatch of a
		// printed halftone rather than the smooth gradient underneath it.
		const dither = (() => {
			// Canonical 8x8 ordered dither matrix, normalized in alloc().
			const BAYER = new Float32Array([
				0, 32, 8, 40, 2, 34, 10, 42,
				48, 16, 56, 24, 50, 18, 58, 26,
				12, 44, 4, 36, 14, 46, 6, 38,
				60, 28, 52, 20, 62, 30, 54, 22,
				3, 35, 11, 43, 1, 33, 9, 41,
				51, 19, 59, 27, 49, 17, 57, 25,
				15, 47, 7, 39, 13, 45, 5, 37,
				63, 31, 55, 23, 61, 29, 53, 21,
			].map((v) => (v + 0.5) / 64));

			// Large features on purpose: at a tighter scale the bands end up
			// smaller than the dither texture sitting on them, and the whole
			// thing reads as hatching rather than as a printed gradient.
			const SCALE = 0.0042;
			// Four levels posterize hard enough that the ordered matrix reads as
			// halftone texture at the band edges rather than as noise everywhere.
			// The value every lit cell carries. One tone, so the mark is constant
			// and only its density varies.
			const INK = 0.82;
			// Enough warp to keep the bands from running straight, not enough to
			// dissolve the shapes they belong to.
			const WARP = 13;

			function fbm(x: number, y: number, z: number) {
				let v = 0, amp = 0.5, f = 1;
				for (let i = 0; i < 3; i++) {
					v += noise(x * f, y * f, z * f) * amp;
					amp *= 0.5;
					f *= 2.07;
				}
				return v;
			}

			return {
				label: 'dither',
				alloc() {},
				step() {
					// The pointer warps the domain locally, so the halftone
					// bends around the probe instead of ignoring it.
					const hasP = hasPointer && mx > -1e4;
					const PR = 220;

					for (let r = 0; r < rows; r++) {
						const y = r * cellH;
						const base = r * cols;
						const brow = (r & 7) << 3;

						for (let c = 0; c < cols; c++) {
							const x = c * cellW;

							let wx = x, wy = y;
							if (hasP) {
								const dx = x - mx, dy = y - my;
								const d = Math.sqrt(dx * dx + dy * dy);
								if (d < PR) {
									const k = (1 - d / PR) ** 2;
									wx += (dx / (d || 1)) * k * WARP * 3;
									wy += (dy / (d || 1)) * k * WARP * 3;
								}
							}

							// Warp the sample point by a second noise field, so
							// the bands fold instead of running straight.
							const w = fbm(wx * SCALE * 0.5, wy * SCALE * 0.5, t * 0.022);
							const g = fbm(wx * SCALE + w * WARP * SCALE, wy * SCALE, t * 0.03);

							// Biased low on purpose: centring the fbm at 0.5 leaves no
							// voids for the pattern to be read against.
							let v = g * 1.3 + 0.21;
							if (v < 0) v = 0; else if (v > 1) v = 1;

							// One bit, which is what ordered dithering actually is.
							// Every lit cell carries the same value and therefore
							// the same glyph, so tone comes from how densely the
							// marks fall rather than from varying them. Quantizing
							// into the full ramp instead puts a different glyph in
							// every cell and reads as speckle.
							fieldOut[base + c] = v > BAYER[brow + (c & 7)] ? INK : 0;
						}
					}
				},
			};
		})();

		// RASTER — a torus rasterized into the cell grid with a z-buffer, lit by
		// a fixed lamp.
		const raster = (() => {
			const R1 = 1, R2 = 2, K2 = 5;
			const THETA_STEP = 0.07, PHI_STEP = 0.02;

			let zbuf = new Float32Array(0);
			let K1x = 30, K1y = 15;
			let a = 0, b = 0;
			// Seeded so two visits do not tumble in lockstep.
			const spinA = 0.17 + rand() * 0.13;
			const spinB = 0.11 + rand() * 0.09;

			return {
				label: 'raster',
				alloc() {
					zbuf = new Float32Array(cols * rows);
					// The 4.6 factor is the zoom.
					K1x = (cols * K2 * 4.6) / (8 * (R1 + R2));
					// Cells are taller than wide; scaling y by the cell aspect
					// keeps the torus circular instead of stretched.
					K1y = K1x * (cellW / cellH);
				},
				step(dt: number) {
					a += spinA * dt;
					b += spinB * dt;

					// The pointer tilts the object rather than deforming it.
					let ta = a, tb = b;
					if (hasPointer && mx > -1e4) {
						ta += (my / H - 0.5) * 1.4;
						tb += (mx / W - 0.5) * 1.4;
					}

					const cA = Math.cos(ta), sA = Math.sin(ta);
					const cB = Math.cos(tb), sB = Math.sin(tb);

					zbuf.fill(0);
					fieldOut.fill(0);

					for (let th = 0; th < 6.2832; th += THETA_STEP) {
						const ct = Math.cos(th), st = Math.sin(th);
						const circleX = R2 + R1 * ct;
						const circleY = R1 * st;

						for (let ph = 0; ph < 6.2832; ph += PHI_STEP) {
							const cp = Math.cos(ph), sp = Math.sin(ph);

							const x = circleX * (cB * cp + sA * sB * sp) - circleY * cA * sB;
							const y = circleX * (sB * cp - sA * cB * sp) + circleY * cA * cB;
							const z = K2 + cA * circleX * sp + circleY * sA;
							const ooz = 1 / z;

							const xp = ((cols / 2 + K1x * ooz * x) | 0);
							const yp = ((rows / 2 - K1y * ooz * y) | 0);
							if (xp < 0 || xp >= cols || yp < 0 || yp >= rows) continue;

							// Normal dotted with a fixed lamp above and behind.
							const lum =
								cp * ct * sB - cA * ct * sp - sA * st + cB * (cA * st - ct * sA * sp);
							if (lum <= 0) continue;

							const i = yp * cols + xp;
							if (ooz > zbuf[i]) {
								zbuf[i] = ooz;
								// lum peaks near sqrt(2); normalize and keep a
								// floor so the lit face never drops out.
								fieldOut[i] = Math.min(1, lum * 0.7 + 0.12);
							}
						}
					}
				},
			};
		})();

		// MOIRE — two radial gratings beating against each other. One centre
		// drifts on its own path, the other is the pointer when there is one,
		// so the interference pattern is something the visitor steers.
		const moire = (() => {
			// Ring spacing must span many cells: at the old frequency a period
			// fell inside a few cells and the interference aliased into noise
			// instead of resolving as rings. These two are close but unequal,
			// which is what produces the beat.
			const F1 = 0.0125, F2 = 0.0138;
			const drift = 0.13 + rand() * 0.14;
			const phase = rand() * 6.2832;

			return {
				label: 'moire',
				alloc() {},
				step() {
					const ax = W * (0.5 + 0.28 * Math.cos(t * drift * 0.6 + phase));
					const ay = H * (0.5 + 0.3 * Math.sin(t * drift * 0.45 + phase));

					const useP = hasPointer && mx > -1e4;
					const bx = useP ? mx : W * (0.5 + 0.3 * Math.cos(t * drift * 0.5 + 2.1));
					const by = useP ? my : H * (0.5 + 0.26 * Math.sin(t * drift * 0.7 + 1.3));

					for (let r = 0; r < rows; r++) {
						const y = r * cellH;
						const base = r * cols;
						const dy1 = y - ay, dy2 = y - by;
						const dy1s = dy1 * dy1, dy2s = dy2 * dy2;

						for (let c = 0; c < cols; c++) {
							const x = c * cellW;
							const dx1 = x - ax, dx2 = x - bx;

							const d1 = Math.sqrt(dx1 * dx1 + dy1s);
							const d2 = Math.sqrt(dx2 * dx2 + dy2s);

							// Product of two gratings: where the rings agree the
							// field lights, where they cancel it goes to ground.
							const s = Math.sin(d1 * F1 - t * 0.26) * Math.sin(d2 * F2 + t * 0.17);
							// Squaring turns the signed product into bright rings on
							// a dark ground and doubles the visible ring count.
							const v = s * s * 0.85;
							fieldOut[base + c] = v > 1 ? 1 : v;
						}
					}
				},
			};
		})();

		const RENDERERS = [flow, dither, raster, moire];

		// Renderers write here; flow keeps its own decaying deposit in `field`
		// and composites ambient on top, so the two buffers stay distinct.
		let fieldOut = new Float32Array(0);

		let modeIndex = (Math.random() * RENDERERS.length) | 0;
		let renderer = RENDERERS[modeIndex];

		// ---- shadow mask ----------------------------------------------------
		// Elements that have to stay readable declare themselves with
		// `data-field-shadow`; the field reads their boxes and steps its own
		// density down underneath them. Geometry, not per-frame work.
		function computeShadow() {
			if (!attn.length) return;
			attn.fill(1);

			const rect = canvas.getBoundingClientRect();
			const targets = document.querySelectorAll<HTMLElement>('[data-field-shadow]');

			targets.forEach((el) => {
				const b = el.getBoundingClientRect();
				if (b.width < 1 || b.height < 1) return;

				const x0 = b.left - rect.left;
				const y0 = b.top - rect.top;
				const x1 = x0 + b.width;
				const y1 = y0 + b.height;

				const cFrom = Math.max(0, ((x0 - feather) / cellW) | 0);
				const cTo = Math.min(cols - 1, ((x1 + feather) / cellW) | 0);
				const rFrom = Math.max(0, ((y0 - feather) / cellH) | 0);
				const rTo = Math.min(rows - 1, ((y1 + feather) / cellH) | 0);

				for (let r = rFrom; r <= rTo; r++) {
					const cy = r * cellH + cellH * 0.5;
					const dy = cy < y0 ? y0 - cy : cy > y1 ? cy - y1 : 0;

					for (let c = cFrom; c <= cTo; c++) {
						const cx = c * cellW + cellW * 0.5;
						const dx = cx < x0 ? x0 - cx : cx > x1 ? cx - x1 : 0;

						// Distance to the box, not its centre, so a wide block
						// of copy carries an even shadow across its width.
						const d = Math.hypot(dx, dy);
						if (d >= feather) continue;

						// Smoothstep: a linear falloff leaves a visible seam.
						const k = 1 - d / feather;
						const v = 1 - shadowDepth * (k * k * (3 - 2 * k));
						const i = r * cols + c;
						if (v < attn[i]) attn[i] = v;
					}
				}
			});
		}

		function resize() {
			const rect = canvas.getBoundingClientRect();
			// The canvas can lay out at zero height for a frame during route
			// transitions; sizing to that would throw away the whole grid.
			if (rect.width < 1 || rect.height < 1) return;

			dpr = Math.min(window.devicePixelRatio || 1, 2);
			W = rect.width;
			H = rect.height;
			canvas.width = Math.round(W * dpr);
			canvas.height = Math.round(H * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			// 8px on desktop, stepping up so small screens stay legible.
			const fontSize = W < 600 ? 12 : W < 1024 ? 10 : 8;
			ctx.font = `${fontSize}px ${FONT}`;
			ctx.textBaseline = 'top';
			cellW = ctx.measureText('M').width || fontSize * 0.6;
			cellH = fontSize * 1.15;

			// The log spans nearly the full width on a phone, so the mask has to
			// be tighter and shallower.
			feather = W < 600 ? 64 : W < 1024 ? 110 : 150;
			shadowDepth = W < 600 ? 0.68 : 0.75;

			cols = Math.ceil(W / cellW) + 1;
			rows = Math.ceil(H / cellH) + 1;

			field = new Float32Array(cols * rows);
			fieldOut = new Float32Array(cols * rows);
			attn = new Float32Array(cols * rows);
			glyph = new Uint8Array(cols);
			shade = new Uint8Array(cols);

			RENDERERS.forEach((r) => r.alloc());
			computeShadow();
		}

		function draw() {
			ctx.fillStyle = BG;
			ctx.fillRect(0, 0, W, H);

			const shadeCount = SHADES.length;
			for (let r = 0; r < rows; r++) {
				const base = r * cols;

				for (let s = 0; s < shadeCount; s++) {
					minC[s] = cols;
					maxC[s] = -1;
				}

				for (let c = 0; c < cols; c++) {
					let v = fieldOut[base + c];
					if (v > 1) v = 1; else if (v < 0) v = 0;

					v *= attn[base + c];

					const q = (v * 255) | 0;
					const gi = LUT[q];
					glyph[c] = gi;
					if (gi === 0) {
						shade[c] = 255; // blank cell, drawn by nobody
						continue;
					}
					const si = SHADE_LUT[q];
					shade[c] = si;
					if (c < minC[si]) minC[si] = c;
					if (c > maxC[si]) maxC[si] = c;
				}

				// One fillText per shade present in this row. Cells belonging to
				// other shades become spaces, which cost nothing and keep every
				// glyph on its exact column.
				const y = r * cellH;
				for (let s = 0; s < shadeCount; s++) {
					const from = minC[s];
					const to = maxC[s];
					if (to < from) continue;
					let line = '';
					for (let c = from; c <= to; c++) {
						line += shade[c] === s ? RAMP[glyph[c]] : ' ';
					}
					ctx.fillStyle = SHADES[s];
					ctx.fillText(line, from * cellW, y);
				}
			}

		}

		function frame(now: number) {
			if (!running) return;
			const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016);
			last = now;
			t += dt;
			renderer.step(dt);
			draw();
			mvx *= 0.86;
			mvy *= 0.86;
			requestAnimationFrame(frame);
		}

		function settle() {
			// Flow needs history before it looks like anything; the others are
			// stateless and resolve in one step.
			const steps = renderer === flow ? 240 : 1;
			for (let i = 0; i < steps; i++) {
				t += 0.016;
				renderer.step(0.016);
			}
			draw();
		}

		function boot() {
			resize();
			if (reduced.matches) {
				settle();
				return;
			}
			running = true;
			last = 0;
			requestAnimationFrame(frame);
		}

		function setMode(next: number) {
			modeIndex = ((next % RENDERERS.length) + RENDERERS.length) % RENDERERS.length;
			renderer = RENDERERS[modeIndex];
			// A renderer inherits a grid, never another renderer's values.
			field.fill(0);
			fieldOut.fill(0);
			renderer.alloc();
			if (reduced.matches) settle();
		}

		// ---- wiring ---------------------------------------------------------
		let resizeQueued = false;
		const ro = new ResizeObserver(() => {
			if (resizeQueued) return;
			resizeQueued = true;
			requestAnimationFrame(() => {
				resizeQueued = false;
				resize();
				if (reduced.matches) settle();
			});
		});
		ro.observe(canvas);

		// The log arrives on a short rise, and a navigation swaps which element
		// sits over the field. Both move the boxes the mask is cut from.
		function refreshShadow() {
			computeShadow();
			if (reduced.matches) draw();
		}

		window.setTimeout(refreshShadow, 1600);
		document.addEventListener('astro:page-load', () => {
			refreshShadow();
			window.setTimeout(refreshShadow, 1600);
		});

		document.addEventListener('field:cycle', () => setMode(modeIndex + 1));

		// Pointer coordinates are canvas-local, not viewport-local.
		window.addEventListener('pointermove', (e) => {
			const rect = canvas.getBoundingClientRect();
			const x = e.clientX - rect.left;
			const y = e.clientY - rect.top;
			if (hasPointer) {
				mvx = x - mx;
				mvy = y - my;
			}
			hasPointer = true;
			mx = x;
			my = y;
		}, { passive: true });

		window.addEventListener('pointerleave', () => {
			hasPointer = false;
			mx = my = -1e5;
			mvx = mvy = 0;
		});

		document.addEventListener('visibilitychange', () => {
			if (reduced.matches) return;
			if (document.hidden) {
				running = false;
			} else if (!running) {
				running = true;
				last = 0;
				requestAnimationFrame(frame);
			}
		});

		boot();
	}
</script>
