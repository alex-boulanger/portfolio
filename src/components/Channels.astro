---
import GlitchLink from './GlitchLink.astro';

// The bottom band: destinations on the left, the crosshair's reading on the
// right. The vector cell is written by Crosshair.astro — the panel reports,
// the probe measures — which is why the markup lives here and the values do not.
//
// `links` comes from the landing entry so both locales stay authored rather
// than translated. Pages without an entry (works, lab) render the band with the
// readout alone, which is the growth slot: new destinations join this row.
interface Props {
	links?: { label: string; href: string }[];
}

const { links = [] } = Astro.props;
---

<footer class="channels">
	<nav>
		{links.map((l) => <GlitchLink href={l.href} label={l.label} />)}
	</nav>
	<span class="vector" aria-hidden="true">
		<i>ang</i><b data-vec="ang">···.·°</b>
		<i>den</i><b data-vec="den">·.···</b>
	</span>
</footer>

<style>
	.channels {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding-top: 0.9rem;
		font-size: 0.6875rem;
		letter-spacing: 0.13em;
		text-transform: lowercase;
	}

	nav {
		display: flex;
		gap: clamp(1.1rem, 3vw, 2.25rem);
	}

	.vector {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5em;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.vector i {
		font-style: normal;
		color: var(--dim);
	}

	.vector i + b {
		margin-right: 0.85em;
	}

	.vector b {
		font-weight: 400;
		color: var(--fg);
		/* Fixed footprint so the row never twitches as the reading changes. */
		white-space: pre;
	}

	/* Nothing measures a pointer that isn't there. */
	@media (hover: none), (pointer: coarse) {
		.vector {
			display: none;
		}
	}

	@media (max-width: 520px) {
		.channels {
			padding-top: 0.75rem;
		}

		/* A narrow window with a mouse attached still has no room for the
		   reading; the destinations own this row. */
		.vector {
			display: none;
		}
	}
</style>
