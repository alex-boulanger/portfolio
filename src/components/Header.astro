---
import GlitchLink from './GlitchLink.astro';

const path = Astro.url.pathname;

const links = [
	{
		href: '/personal-projects',
		label: 'projects',
		current: path === '/personal-projects',
	},
	{
		href: '/writing',
		label: 'writing',
		current: path === '/writing' || path.startsWith('/writing/'),
	},
];
---

<header>
	<GlitchLink href="/" label="alex boulanger" />
	<nav class="primary-nav" aria-label="Primary">
		{links.map((l) => <GlitchLink href={l.href} label={l.label} current={l.current} />)}
	</nav>
</header>

<style>
	header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.9rem 0;
		font-size: 0.6875rem;
		letter-spacing: 0.13em;
	}

	nav {
		display: flex;
		align-items: baseline;
		gap: 1.25rem;
	}

	@media (max-width: 520px) {
		header {
			padding: 0 0.65rem 0.75rem;
		}
		nav {
			gap: 0.75rem;
		}
	}
</style>
