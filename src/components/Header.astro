---
import GlitchLink from './GlitchLink.astro';

const locale = Astro.currentLocale ?? 'en';

// The same page in the other locale, so switching never loses your place.
const path = Astro.url.pathname.replace(/^\/fr(?=\/|$)/, '') || '/';
const frPath = `/fr${path === '/' ? '' : path}`;

const links = [
	{
		href: locale === 'fr' ? '/fr/personal-projects' : '/personal-projects',
		label: 'projects',
		current: path === '/personal-projects',
	},
];
---

<header>
	<GlitchLink href={locale === 'fr' ? '/fr' : '/'} label="alex boulanger" />
	<nav>
		{links.map((l) => <GlitchLink href={l.href} label={l.label} current={l.current} />)}
	</nav>
	<nav>
		<GlitchLink href={path} label="en" current={locale === 'en'} />
		<GlitchLink href={frPath} label="fr" current={locale === 'fr'} />
	</nav>
</header>

<style>
	header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.9rem 0;
		font-size: 0.6875rem;
		letter-spacing: 0.13em;
	}

	nav {
		display: flex;
		align-items: baseline;
		gap: 1.25rem;
	}

	@media (max-width: 520px) {
		header {
			padding: 0 0.65rem 0.75rem;
		}
		nav {
			gap: 1rem;
		}
	}
</style>
