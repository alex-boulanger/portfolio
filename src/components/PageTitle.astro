---
interface Props {
	text: string;
}

const { text } = Astro.props;
---

<h1 data-field-shadow>{text}</h1>

<style>
	h1 {
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 400;
		letter-spacing: 0.35em;
		text-indent: 0.35em;
		color: var(--fg);
		text-shadow:
			0 0 8px var(--bg),
			0 0 18px var(--bg),
			0 0 30px var(--bg);
		animation: in 0.6s ease both;
	}

	@keyframes in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		h1 {
			animation: none;
		}
	}
</style>
