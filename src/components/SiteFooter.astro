---
import GlitchLink from './GlitchLink.astro';

interface Props {
	links?: { label: string; href: string }[];
}

const { links = [] } = Astro.props;
---

<footer class="site-footer">
	<nav>
		{links.map((l) => <GlitchLink href={l.href} label={l.label} />)}
	</nav>
</footer>

<style>
	.site-footer {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding-top: 0.9rem;
		font-size: 0.6875rem;
		letter-spacing: 0.13em;
		text-transform: lowercase;
	}

	nav {
		display: flex;
		gap: clamp(1.1rem, 3vw, 2.25rem);
	}

	@media (max-width: 520px) {
		.site-footer {
			gap: 1rem;
			padding-top: 0.75rem;
		}

		nav {
			gap: 1rem;
		}
	}
</style>
